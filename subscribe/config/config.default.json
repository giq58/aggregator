{
  "crawl": {
    "enable": true,
    "google": {
      "enable": true,
      "limits": 100, 
      "push_to": ["suuwu_nodes"],
      "queries":[
        // 使用 Google 引擎限定在 github.com 域名下搜索这个带 token 的网址
        "\"https://train.suuwu.de/api/linkon?token=\" site:github.com",
        "\"train.suuwu.de/api/linkon\" site:github.com",
        
        // 顺便搜一下 pastebin 等其他容易泄露代码的网站（可选）
        "\"train.suuwu.de/api/linkon\" site:pastebin.com"
      ]
    }
  },
  "groups": {
    "suuwu_nodes": {
      "targets": {
        "clash": "clash_suuwu",
        "v2ray": "v2ray_suuwu"
      }
    }
  },
  "storage": {
    "engine": "gist",
    "items": {
      "clash_suuwu": {
        "username": "你的GitHub用户名",
        "gistid": "你的GistID",
        "filename": "suuwu-leaked.yaml"
      }
    }
  }
}
